.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local config / secrets
.env
.env.local
*.pem
*.key
*.crt
secrets/
local/

# Conformance test signing key: the PUBLIC half is published in the corpus
# (pub.hex + the PKIX BEGIN-PUBLIC-KEY pem). The global *.pem rule above would
# otherwise ignore the public pem, so force-allow ONLY the two public files.
# Every private artifact (seed hex, private pem) stays out by name and is never
# stored in this repo — it lives local-only under TESSERASEAL_TEST_KEY_DIR.
!spec/test-vectors/_keys/test-signing-key.pub.hex
!spec/test-vectors/_keys/test-signing-key.ed25519.pub.pem
spec/test-vectors/_keys/*.seed.hex
spec/test-vectors/_keys/test-signing-key.ed25519.pem

# Working notes (forward-needs, gap manifest, etc. — not part of the published artifact set)
docs/future-needs/

# Auditor-story synopses — kept as local working drafts going forward.
# Already-committed synopses remain in history; new synopsis edits stay
# local unless added with `git add -f`. Stories carry real-world stack
# coupling (TPB/Prosperity, Jack Henry/Banno/Yello/Insider, Fiserv DNA,
# etc.) and are deliberately held local rather than auto-tracked.
docs/synopsis/

# Personal knowledge-base tooling (separate clone of coleam00/claude-memory-compiler)
claude-memory-compiler/

# Publisher's cached working trees for downstream targets (always re-cloned)
.publish-cache/
/docs/review-2026-05-10/
/docs/review-2026-05-11/
/docs/submissions/
